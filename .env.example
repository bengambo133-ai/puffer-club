# Vercel/Vite exposes VITE_* values to the browser. Only use the Supabase anon/publishable key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Keep secret values in Vercel Project Settings > Environment Variables.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
SITE_URL=

# Merchant settings. Set only after confirming product catalog, prices, tax and delivery rules.
STORE_LIVE_CATALOG_CONFIRMED=false
STRIPE_ALLOWED_COUNTRIES=FR
STRIPE_SHIPPING_RATE_ID=
STRIPE_TAX_BEHAVIOR=inclusive
STRIPE_AUTOMATIC_TAX=false
